#!/bin/bash
# cli — Human-Agent Coexistence CLI 本地入口
#
# 无需安装到系统，在项目目录下直接运行即可。
# 首次使用自动构建，无需手动操作。
#
# 补全支持：
#   zsh: source completions/setup.zsh（当前 shell）
#        ./setup-completions.sh（永久安装）
#   bash: ./setup-completions.sh --bash
#
# 用法:
#   ./cli status
#   ./cli plans
#   ./cli help

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HAC_BIN="$SCRIPT_DIR/.agent/cli-src/dist/cli"
CLI_DIR="$SCRIPT_DIR/.agent/cli-src"

# 补全模式检测（bash）
if [[ -n "$COMP_LINE" ]]; then
  echo "status plans decisions summary browser context chrome watch help --version"
  exit 0
fi

# 首次使用：自动构建
if [ ! -f "$HAC_BIN" ]; then
    echo "🔨 首次使用，正在构建 CLI..."
    
    if ! command -v bun &> /dev/null; then
        echo ""
        echo "❌ 未找到 bun"
        echo "   请先安装 Bun: https://bun.sh"
        echo ""
        echo "   macOS/Linux:"
        echo "     curl -fsSL https://bun.sh/install | bash"
        echo ""
        exit 1
    fi
    
    echo "   📦 安装依赖..."
    cd "$CLI_DIR" && bun install
    
    echo "   🔨 编译 CLI..."
    bun run build
    
    echo ""
    echo "✅ 构建完成！"
    echo ""
fi

exec "$HAC_BIN" "$@"
