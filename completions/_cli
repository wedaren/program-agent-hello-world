#compdef cli

# zsh 补全函数 for Human-Agent Coexistence CLI
# 
# 设计原则：只安装一次，但补全内容动态获取。
# 每次按 tab 时，检测当前目录是否有 ./cli，有则调用它获取该项目的命令列表。
# 这样多个项目不会冲突，每个项目显示自己的命令。

_cli() {
  local -a cmds
  
  # 如果当前目录有 ./cli，动态获取该项目的命令
  if [[ -x ./cli ]]; then
    cmds=(${(s: :)$(./cli --completions 2>/dev/null)})
  fi
  
  # 回退：如果获取失败，使用默认命令
  if [[ ${#cmds} -eq 0 ]]; then
    cmds=(status plans decisions summary browser context chrome watch help)
  fi
  
  _describe 'command' cmds
}

_cli "$@"
