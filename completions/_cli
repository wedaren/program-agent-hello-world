#compdef cli

# zsh 补全函数 for Human-Agent Coexistence CLI
# 
# 设计：只安装一次，补全内容动态获取。
# 每次按 tab，检测当前目录的 ./cli，调用它获取当前项目的命令。
# 多项目不冲突，二级命令自动同步。

_cli() {
  local -a cmds
  local parent="${words[2]}"  # 当前已输入的第一个参数（如 chrome）
  
  # 动态获取：传递父命令给 ./cli --completions，获取子命令
  if [[ -x ./cli ]]; then
    cmds=(${(s: :)$(./cli --completions "$parent" 2>/dev/null)})
  fi
  
  # 回退
  if [[ ${#cmds} -eq 0 ]]; then
    cmds=(status plans decisions summary browser context chrome watch help)
  fi
  
  _describe 'command' cmds
}

_cli "$@"
